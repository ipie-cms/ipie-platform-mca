{
  "realm": "ipie",
  "enabled": true,
  "sslRequired": "none",
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging",
    "ipie-login-notifier"
  ],
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Platform operator - top of the role hierarchy, above PILLAR_ADMIN and deliberately not composed of it: a super admin governs pillar admins rather than being one. Composite: full user/organisation/document/role management.",
        "composite": true,
        "composites": {
          "realm": [
            "USER_READ",
            "USER_WRITE",
            "USER_DELETE",
            "ORGANISATION_READ",
            "ORGANISATION_WRITE",
            "DOCUMENT_READ",
            "DOCUMENT_WRITE",
            "ROLES_MANAGE",
            "RBAC_DEFINE",
            "NOTIFICATIONS_VIEW"
          ]
        }
      },
      {
        "name": "USER_READ",
        "description": "Read access to the User API"
      },
      {
        "name": "USER_WRITE",
        "description": "Create/update access to the User API"
      },
      {
        "name": "USER_DELETE",
        "description": "Soft-delete/reactivate access to the User API"
      },
      {
        "name": "DOCUMENT_READ",
        "description": "Read/download access to the Document API"
      },
      {
        "name": "DOCUMENT_WRITE",
        "description": "Upload access to the Document API"
      },
      {
        "name": "STAKEHOLDER",
        "description": "Default role auto-assigned on registration verification (ipie-iam-service)"
      },
      {
        "name": "PILLAR_ADMIN",
        "description": "Administers one pillar (IBBI/NCLT/NCLAT/MCA/NeSL) and its users - verifies pending registrations and manages roles. Below SUPER_ADMIN in the hierarchy, not a platform operator.",
        "composite": true,
        "composites": {
          "realm": [
            "ROLES_MANAGE",
            "USER_READ",
            "REGISTRATIONS_VERIFY",
            "DASHBOARD_VIEW"
          ]
        }
      },
      {
        "name": "CREDITOR",
        "description": "IBC creditor stakeholder"
      },
      {
        "name": "INSOLVENCY_PROFESSIONAL",
        "description": "IBC insolvency professional stakeholder"
      },
      {
        "name": "REGISTERED_VALUER",
        "description": "IBC registered valuer stakeholder (RV/RVE Login)"
      },
      {
        "name": "LEGAL_REPRESENTATIVE",
        "description": "Legal entity/legal representative stakeholder"
      },
      {
        "name": "AUTHORIZED_REPRESENTATIVE",
        "description": "Authorized representative of a creditor/stakeholder class"
      },
      {
        "name": "IBBI_OFFICIAL",
        "description": "IBBI senior official - platform regulator, not a case stakeholder"
      },
      {
        "name": "PILLAR_LINK_RESOLVE",
        "description": "Calls POST /internal/pillar-links/resolve on ipie-iam-service - granted only to the ipie-keycloak-spi service account"
      },
      {
        "name": "ORGANISATION_READ",
        "description": "Read access to the Organisation API"
      },
      {
        "name": "ORGANISATION_WRITE",
        "description": "Create/update access to the Organisation API"
      },
      {
        "name": "ACCOUNT_PROVISION",
        "description": "Calls POST /internal/accounts on ipie-iam-service - granted only to the ipie-user-service service account"
      },
      {
        "name": "LOGIN_NOTIFY",
        "description": "Calls POST /internal/logins/notify on ipie-user-service - granted only to the ipie-keycloak-spi service account"
      },
      {
        "name": "ROLES_MANAGE",
        "description": "Assign an existing role to a user and withdraw it - gates POST/DELETE/GET /api/v1/users/{userId}/roles on ipie-iam-service. Defining roles and permissions is RBAC_DEFINE, held only by SUPER_ADMIN."
      },
      {
        "name": "RBAC_DEFINE",
        "description": "Define the RBAC catalogue - gates POST/PUT/DELETE /api/v1/roles and POST /api/v1/permissions on ipie-iam-service. SUPER_ADMIN only: assigning a role hands out an existing capability, defining one decides what capabilities exist."
      },
      {
        "name": "NOTIFICATIONS_VIEW",
        "description": "View every notification ever sent, any recipient - gates GET /api/v1/notifications on ipie-communication-service. Granted only to SUPER_ADMIN."
      },
      {
        "name": "CREDENTIAL_VERIFY",
        "description": "Calls POST /internal/credentials/verify on ipie-iam-service - granted only to the ipie-keycloak-spi service account. Keycloak holds no passwords; this is how it asks iam whether one is correct."
      }
    ]
  },
