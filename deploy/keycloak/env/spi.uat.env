# ipie-keycloak-spi - uat
#
# PLACEHOLDER HOSTNAMES. Replace them with this environment's real ones; they were never verified
# against a deployed uat and are here to give the file its shape, not its values.
#
# Secrets are NOT in this file and must never be committed to one. __FROM_SECRET_STORE__ is injected
# by the deployment. Keycloak refuses to start if any of these is missing, naming the variable - see
# SpiConfig and the README beside this file.
IPIE_ENV=uat

# Keycloak reaching itself: always localhost, since the SPI runs inside Keycloak's process. State
# the port and scheme this environment's Keycloak actually serves on - behind a TLS-terminating
# proxy that is still the local plaintext listener, not the public URL.
IPIE_KEYCLOAK_BASE_URL=http://localhost:8080

# Where the services answer from Keycloak's host. Server-to-server addresses, inside the
# deployment's own network - not the public ingress.
IPIE_IAM_SERVICE_BASE_URL=https://iam.uat.ipie.internal
IPIE_USER_SERVICE_BASE_URL=https://user.uat.ipie.internal

# Public, browser-facing: where an unlinked pillar SSO login is redirected to register.
IPIE_WEB_REGISTER_URL=https://ipie-uat.example.gov.in/register

IPIE_KEYCLOAK_SPI_CLIENT_SECRET=__FROM_SECRET_STORE__
IPIE_SPI_HMAC_SECRET=__FROM_SECRET_STORE__
IPIE_SPI_HMAC_SECRET_USER=__FROM_SECRET_STORE__
