# ipie-keycloak-spi - dev (a developer's own machine)
#
# The only file here with real values: these are local-development shared secrets, identical to the
# ones in docker-compose.services.yml, and worthless anywhere else.
#
# Every value below is also SpiConfig's built-in dev default, so a laptop that loads nothing at all
# still works. The file exists so the dev environment is stated in the same shape as every other
# one, and so a developer can point at a differently-placed stack without editing code.
IPIE_ENV=dev

# Keycloak reaching itself. Always localhost - the SPI runs inside Keycloak's process - but the port
# is a deployment choice. NOT 9090: that is Prometheus in the local stack, and pointing here made
# every login fail closed with 503 temporarily_unavailable until 2026-08-13.
IPIE_KEYCLOAK_BASE_URL=http://localhost:8080

# The services as published on the developer's machine. In the standard local topology these are
# Docker containers publishing onto the host, which is how host-Keycloak reaches them.
IPIE_IAM_SERVICE_BASE_URL=http://localhost:8093
IPIE_USER_SERVICE_BASE_URL=http://localhost:8092
IPIE_WEB_REGISTER_URL=http://localhost:5173/register

IPIE_KEYCLOAK_SPI_CLIENT_SECRET=ipie-keycloak-spi-secret
IPIE_SPI_HMAC_SECRET=local-dev-spi-to-iam-shared-secret
IPIE_SPI_HMAC_SECRET_USER=local-dev-spi-to-user-shared-secret
