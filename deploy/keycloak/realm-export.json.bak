      }
    },
    {
      "alias": "nclat",
      "displayName": "NCLAT",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "ipie-stakeholder-first-broker-login",
      "config": {
        "clientId": "ipie-broker",
        "clientSecret": "ipie-broker-secret",
        "authorizationUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/certs",
        "issuer": "http://keycloak-nclt-mock:9092/realms/nclt-mock",
        "userInfoUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/userinfo",
        "logoutUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "syncMode": "IMPORT",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid"
      }
    },
    {
      "alias": "mca",
      "displayName": "MCA",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
