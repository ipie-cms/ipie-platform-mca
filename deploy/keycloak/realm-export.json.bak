      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "ipie-stakeholder-first-broker-login",
      "config": {
        "clientId": "ipie-broker",
        "clientSecret": "ipie-broker-secret",
        "authorizationUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/token",
