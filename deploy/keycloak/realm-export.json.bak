        "LOGIN_NOTIFY"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ipie-service-template",
      "name": "iPIE Service Template (local dev)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ipie-service-template-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "webOrigins": [
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-to-permissions-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "permissions",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "ipie-user-service",
      "name": "iPIE User Service (local dev)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ipie-user-service-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Client-credentials only - authenticates InterServiceClient calls to ipie-iam-service's /internal/accounts, plus direct realm-management/manage-users calls. Service account granted manage-users and ACCOUNT_PROVISION only, not full admin.",
      "protocolMappers": [
        {
          "name": "realm-roles-to-permissions-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "permissions",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "ipie-iam-service",
      "name": "iPIE IAM Service (local dev)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ipie-iam-service-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Client-credentials only - backs KeycloakUserManagementClient.ensureRealmRole/assignRealmRoles. Service account also granted realm-management/manage-realm (role definition CRUD), not full admin."
    },
    {
      "clientId": "ipie-keycloak-spi",
      "name": "iPIE Keycloak SPI (local dev)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ipie-keycloak-spi-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Client-credentials only - used by StakeholderLinkResolverClient (resolve stakeholder links) and LoginNotificationClient (login notifications) to call ipie-iam-service/ipie-user-service. Granted only STAKEHOLDER_LINK_RESOLVE and LOGIN_NOTIFY.",
      "protocolMappers": [
        {
          "name": "realm-roles-to-permissions-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "claim.name": "permissions",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "ipie-web-sso",
      "name": "iPIE Web - stakeholder SSO (local dev)",
      "enabled": true,
      "publicClient": true,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/sso/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "description": "Public, PKCE-only client for LoginPage's stakeholder-SSO redirect and SsoCallbackPage's code exchange. No client secret - a public SPA client must never hold one."
    }
  ],
  "authenticationFlows": [
    {
      "alias": "ipie-stakeholder-first-broker-login",
      "description": "Replaces Keycloak's default first-broker-login with ipie-keycloak-spi's StakeholderLinkResolverAuthenticator - succeeds only if an explicit link exists in stakeholder_links (see StakeholderLinkService.completeLinkCallback).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ipie-stakeholder-link-resolver",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "ipie-browser",
      "description": "Browser login. Mirrors Keycloak's built-in browser flow, with the password step replaced by ipie-auth-username-password-form, which validates against ipie-iam-service - Keycloak stores no password.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "ipie-browser-forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "ipie-browser-forms",
      "description": "Username/password, then conditional OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "ipie-auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "ipie-browser-conditional-otp",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "ipie-browser-conditional-otp",
      "description": "OTP, only for users who have one configured.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    },
    {
      "alias": "ipie-direct-grant",
      "description": "Resource-owner password grant - the flow ipie-web's login page uses. Password validated by ipie-direct-grant-validate-password against ipie-iam-service.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "direct-grant-validate-username",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "ipie-direct-grant-validate-password",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "flowAlias": "ipie-direct-grant-conditional-otp",
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true
        }
      ]
    },
    {
      "alias": "ipie-direct-grant-conditional-otp",
      "description": "OTP, only for users who have one configured.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "direct-grant-validate-otp",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "ibbi",
      "displayName": "IBBI",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "ipie-stakeholder-first-broker-login",
      "config": {
        "clientId": "ipie-broker",
        "clientSecret": "ipie-broker-secret",
        "authorizationUrl": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock/protocol/openid-connect/certs",
        "issuer": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock",
        "userInfoUrl": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock/protocol/openid-connect/userinfo",
        "logoutUrl": "http://keycloak-ibbi-mock:9091/realms/ibbi-mock/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "syncMode": "IMPORT",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid"
      }
    },
    {
      "alias": "nclt",
      "displayName": "NCLT",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
