        "userInfoUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/userinfo",
        "logoutUrl": "http://keycloak-nclt-mock:9092/realms/nclt-mock/protocol/openid-connect/logout",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "syncMode": "IMPORT",
