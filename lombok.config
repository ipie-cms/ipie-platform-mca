config.stopBubbling = true

# PillarLinkServiceImpl (ipie-user-service) relies on Lombok copying its fields' own
# @Value("${...}") annotations onto the parameters of its generated @RequiredArgsConstructor
# constructor (its own Javadoc says as much) - Lombok does not do this for arbitrary annotations
# by default, only for ones explicitly listed here, so without this line that class's Duration/
# String @Value-bound fields silently get no annotation on the generated constructor parameter at
# all, and Spring fails to start the whole service with NoSuchBeanDefinitionException.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
